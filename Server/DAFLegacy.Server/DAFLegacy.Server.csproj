<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationIcon>DAFLegacy.Server.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- SQLite 存储基础设施（docs/design/08-sqlite-storage.md D1）。
         bundle 包提供各平台的原生库，是 Microsoft.Data.Sqlite 在非 Windows
         平台运行的前提。 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- 自检需要直接驱动存储内部（建库、整库播种、版本互验），故开放 internal。 -->
    <InternalsVisibleTo Include="DAFLegacy.Server.SelfTests" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="server.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- 基线 schema（统称 60A1）是本模块的建库资产，也是全仓唯一定名来源：
     基线内容变更直接改本文件，增量迁移另见 Sqlite/SqliteMigrations.cs。基线只含
     DDL 与静态种子（server_settings 播种），不含账号/角色数据种子——无库且无
     state.json 时由服务端启动流程播种 test/test 账号与预置角色。 -->
    <Content Include="Sqlite/act1_schema.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
